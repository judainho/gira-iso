{# Generated by vmforge. Edit the spec, not this file. #}
# spec_sha256: {{ spec_sha256 }}
# packages: {{ packages | join(" ") }}
# services: {{ services | join(" ") }}

packer {
  required_version = ">= 1.10.0"

  required_plugins {
    qemu = {
      version = "= {{ plugin_version }}"
      source  = "github.com/hashicorp/qemu"
    }
  }
}

variable "base_image" {
  type = string
}

variable "base_sha256" {
  type = string
}

variable "seed_dir" {
  type = string
}

variable "ssh_private_key_file" {
  type = string
}

variable "build_dir" {
  type = string
}

source "qemu" "ubuntu" {
  iso_url      = "file://${var.base_image}"
  iso_checksum = "sha256:${var.base_sha256}"

  disk_image       = true
  output_directory = "${var.build_dir}/image"
  vm_name          = "{{ image_name }}"
  format           = "qcow2"
  # Packer defaults this to 40960 MB even for a disk_image.
  disk_size        = {{ disk_size_mb }}

  accelerator  = "kvm"
  machine_type = "q35"
  cpus         = {{ cpus }}
  memory       = {{ memory }}
  headless     = true

  # Plugin 1.1.7 does not expose cpu_type; without this the guest runs on qemu64.
  qemuargs = [["-cpu", "host"]]

  disk_interface = "virtio"
  net_device     = "virtio-net"

  cd_files = ["${var.seed_dir}/user-data", "${var.seed_dir}/meta-data"]
  cd_label = "cidata"

  ssh_username           = "packer"
  ssh_private_key_file   = var.ssh_private_key_file
  ssh_timeout            = "20m"
  ssh_handshake_attempts = 60

  shutdown_command = "sudo shutdown -P now"
}

build {
  name    = "vmforge"
  sources = ["source.qemu.ubuntu"]

  # Wait for cloud-init, then assert that the spec is actually in the image.
  # Installing a package and asserting it are two different claims.
  provisioner "shell" {
    execute_command = "{% raw %}{{ .Vars }}{% endraw %} sudo -E bash -euxo pipefail '{% raw %}{{ .Path }}{% endraw %}'"
    script          = "${var.build_dir}/provision/assert.sh"
  }

  # Nothing of the build may survive into the image: not the instance state, not
  # the machine identity, not the build key or its shell history.
  provisioner "shell" {
    execute_command = "{% raw %}{{ .Vars }}{% endraw %} sudo -E bash -euxo pipefail '{% raw %}{{ .Path }}{% endraw %}'"
    script          = "${var.build_dir}/provision/cleanup.sh"
  }
}
