#!/usr/bin/env bash
# Generated by vmforge. Asserts the image matches the spec before it is cleaned.
set -euo pipefail

# cloud-init installs packages during the first boot of the build VM.
cloud-init status --wait || true
systemctl is-system-running --wait || true

{% for pkg in packages %}
dpkg -l '{{ pkg }}' 2>/dev/null | grep -q '^ii' \
  || { echo "MISSING package: {{ pkg }}" >&2; exit 1; }
{% endfor %}

{% for svc in services %}
systemctl is-enabled '{{ svc }}' >/dev/null 2>&1 \
  || { echo "NOT ENABLED service: {{ svc }}" >&2; exit 1; }
{% endfor %}

echo "assertions passed: {{ packages | length }} package(s), {{ services | length }} service(s)"
