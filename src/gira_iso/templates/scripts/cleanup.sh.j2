#!/usr/bin/env bash
# Generated by gira-iso. Removes every trace of the build, then proves it did.
set -euo pipefail

apt-get clean
rm -rf /var/lib/apt/lists/*

# Machine identity: a cloned image must generate its own on first boot.
truncate -s 0 /etc/machine-id
rm -f /var/lib/dbus/machine-id

# Host keys: shared host keys across every image built from this base are a
# man-in-the-middle opportunity, not a convenience.
rm -f /etc/ssh/ssh_host_*

rm -f /root/.bash_history /home/packer/.bash_history

# --seed drops the instance and seed state so the next boot treats cloud-init as
# unconfigured; --logs removes this build's cloud-init logs.
cloud-init clean --logs --seed

sync

# Assertions: an image that fails one of these must never reach a manifest.
test ! -s /etc/machine-id
test ! -e /var/lib/cloud/seed/nocloud
test ! -e /var/lib/cloud/instance
test -z "$(ls -A /etc/ssh/ssh_host_* 2>/dev/null || true)"
test ! -f /root/.bash_history

echo "clean-state assertions passed"
