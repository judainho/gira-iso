#!/usr/bin/env bash
# Generated by gira-iso. Runs as the very last step, in place of a plain shutdown.
#
# The build user is how Packer got in: it has passwordless sudo, and the private half of its
# key sits on the build host. If it stayed in the image, whoever holds that key could log in
# as root to every machine started from it. It cannot go earlier because Packer is still
# connected as it, so it is removed here, the removal is verified, and only then does the
# machine power off. Any failure leaves the VM running and fails the build: no manifest.
set -euo pipefail

BUILD_USER='{{ build_user }}'
SUDOERS_DIR='{{ sudoers_dir }}'
SUDOERS_FILE='{{ sudoers_file }}'
HOME_ROOT='{{ home_root }}'
KEY_MARKER='{{ key_marker }}'

fail() {
  echo "FINALIZE FAILED: $*" >&2
  exit 1
}

# cloud-init keeps every user's sudo rule in one file shared with the spec's own users, so
# delete only the build user's line and leave the others alone.
if [ -f "$SUDOERS_FILE" ]; then
  sed -i "/^${BUILD_USER}[[:space:]]/d" "$SUDOERS_FILE"
fi

userdel --remove --force "$BUILD_USER" || true

# Prove it. `|| true` above is deliberate: the checks below are the real verdict.
getent passwd "$BUILD_USER" >/dev/null && fail "user $BUILD_USER still exists"
getent group "$BUILD_USER" >/dev/null && fail "group $BUILD_USER still exists"
[ ! -e "$HOME_ROOT/$BUILD_USER" ] || fail "$HOME_ROOT/$BUILD_USER still exists"

if grep -rqsE "^${BUILD_USER}[[:space:]]" "$SUDOERS_DIR" "${SUDOERS_DIR%/*}/sudoers"; then
  fail "a sudo rule for $BUILD_USER remains"
fi

# The build key's public half carries a marker comment; it must be nowhere in the image.
if grep -rqs -- "$KEY_MARKER" "$HOME_ROOT" /root /etc/ssh 2>/dev/null; then
  fail "the build key is still present"
fi

echo "build user removed and verified"
rm -f -- "$0"
sync
{{ poweroff }}
