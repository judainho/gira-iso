#!/usr/bin/env bash
# Generated by gira-iso. Asserts the image matches the spec before it is cleaned.
set -euo pipefail

# cloud-init installs packages during the first boot of the build VM.
cloud-init status --wait || true
systemctl is-system-running --wait || true

{% for pkg in packages %}
dpkg -l '{{ pkg }}' 2>/dev/null | grep -q '^ii' \
  || { echo "MISSING package: {{ pkg }}" >&2; exit 1; }
{% endfor %}

{% for svc in services %}
systemctl is-enabled '{{ svc }}' >/dev/null 2>&1 \
  || { echo "NOT ENABLED service: {{ svc }}" >&2; exit 1; }
{% endfor %}

{% for snap in snaps %}
snap list '{{ snap.name }}' 2>/dev/null | grep -q '^{{ snap.name }} ' \
  || { echo "MISSING snap: {{ snap.name }}" >&2; exit 1; }
{% if snap.revision %}
# The revision is pinned in the policy: a channel drift must fail the build, not the manifest.
test "$(snap list '{{ snap.name }}' | awk 'NR==2 {print $3}')" = '{{ snap.revision }}' \
  || { echo "WRONG snap revision: {{ snap.name }} (expected {{ snap.revision }})" >&2; exit 1; }
{% endif %}
{% endfor %}

echo "assertions passed: {{ packages | length }} package(s), {{ services | length }} service(s), {{ snaps | length }} snap(s)"
