#!/usr/bin/env bash
# Generated by gira-iso. Adds the vendor apt repositories the spec needs.
#
# A repository key is root trust: it signs every package apt will ever install from that
# source, not only the ones named here. So the key is downloaded, its sha256 checked against
# the pin in the policy, and only then installed. A mismatch fails the build; it never
# "warns and continues".
set -euo pipefail

fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 3 --max-time 60 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    echo "neither curl nor wget is available to fetch $1" >&2
    exit 1
  fi
}

install -d -m 0755 /usr/share/keyrings /etc/apt/sources.list.d
{% for repo in repositories %}
# --- {{ repo.id }} ---
key="$(mktemp)"
fetch '{{ repo.key_url }}' "$key"
printf '%s  %s\n' '{{ repo.key_sha256 }}' "$key" | sha256sum -c -
install -m 0644 "$key" /usr/share/keyrings/{{ repo.id }}.asc
rm -f "$key"

cat > /etc/apt/sources.list.d/{{ repo.id }}.sources <<'EOF'
Types: deb
URIs: {{ repo.url }}
Suites: {{ repo.suite }}
Components: {{ repo.components | join(' ') }}
Signed-By: /usr/share/keyrings/{{ repo.id }}.asc
EOF
{% endfor %}

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends {{ all_packages | join(' ') }}

echo "repositories ready: {{ repositories | map(attribute='id') | join(', ') }}"
